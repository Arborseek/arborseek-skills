{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/xiaohongshu-illustrated-post/production-plan.schema.json",
  "title": "Xiaohongshu illustrated post production plan",
  "type": "object",
  "required": ["title", "visual_intent", "theme", "pages"],
  "properties": {
    "version": {"const": 1},
    "slug": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "body": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "visual_intent": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 512, "maximum": 4096},
        "height": {"type": "integer", "minimum": 512, "maximum": 4096}
      }
    },
    "theme": {
      "type": "object",
      "required": ["id", "reason", "dna"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "reference_assets": {
          "description": "Optional runtime paths for user-provided style references; leave empty when none are supplied.",
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 4
        },
        "dna": {
          "type": "object",
          "required": ["substrate", "type_voice", "palette_roles", "stroke_light", "graphic_language", "density", "motif"],
          "properties": {
            "substrate": {"type": "string", "minLength": 1},
            "type_voice": {"type": "string", "minLength": 1},
            "palette_roles": {"type": "string", "minLength": 1},
            "stroke_light": {"type": "string", "minLength": 1},
            "graphic_language": {"type": "string", "minLength": 1},
            "density": {"type": "string", "minLength": 1},
            "motif": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["role", "purpose", "core_claim", "information_units", "layout", "text_blocks"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "core_claim": {"type": "string", "minLength": 1},
          "information_units": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 8},
          "image_prompt": {"type": "string"},
          "background_file": {"type": "string", "pattern": "^[^/\\\\]+\\.png$"},
          "output_file": {"type": "string", "pattern": "^[^/\\\\]+\\.png$"},
          "layout": {
            "type": "object",
            "required": ["backbone"],
            "properties": {
              "backbone": {
                "enum": ["editorial-stack", "vertical-flow", "split-contrast", "center-out", "input-process-output", "matrix-grid", "layered-system", "narrative-panels"]
              },
              "modules": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
              "reading_path": {"type": "string"},
              "emphasis": {"type": "string"}
            }
          },
          "text_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "box"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "box": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                    {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                  ],
                  "minItems": 4,
                  "maxItems": 4
                },
                "font_size": {"type": "integer", "minimum": 8, "maximum": 320},
                "min_font_size": {"type": "integer", "minimum": 8, "maximum": 320},
                "color": {"type": "string"},
                "align": {"enum": ["left", "center", "right"]},
                "valign": {"enum": ["top", "center", "bottom"]},
                "weight": {"enum": ["regular", "bold"]},
                "line_spacing": {"type": "number", "minimum": 0.8, "maximum": 2.5},
                "padding": {"type": "integer", "minimum": 0, "maximum": 160},
                "background": {"type": "string"},
                "radius": {"type": "integer", "minimum": 0, "maximum": 200},
                "stroke_width": {"type": "integer", "minimum": 0, "maximum": 20},
                "stroke_fill": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
